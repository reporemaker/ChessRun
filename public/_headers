# Cloudflare Pages başlıkları (oyun, chessrun.app).
#
# YOLLAR: oyun adresleri /play/classic|kingRun|trio ve /daily (src/ui/route.ts)
# Pages'in SPA fallback'ine dayanır: 404.html YOK, bilinmeyen yol index.html.
# public/'e 404.html KOYMA. Worker rotaları apex'te /collect /s /lb - oyun
# bu öneklerin altında adres kullanmaz. Oyun tamamen aynı
# origin'den besleniyor: harici betik/stil/yazı tipi yok, API'ler /collect ve
# /lb apex'te. Bu yüzden CSP sıkı tutulabiliyor. 'unsafe-inline' yalnızca
# stil için: React satır içi stil atıyor.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Hash'li varlıklar: bir yıl, değişmez
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Yazı tipleri (hakkında sayfası, /fonts/*.woff2): içerik değişmez, ad sabit;
# değişirse dosya adı değişir
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker her seferinde ağdan denetlensin. Yalnızca `no-cache`
# YETMEDİ: max-age yoksa Cloudflare zone varsayılanı (tarayıcı TTL 4 sa)
# başlığı `max-age=14400` yapıyordu → SW güncellemesi 4 saate kadar gecikti
# (19 Ağustos canlıda görüldü). Açık max-age=0 kenarda korunuyor (`/` gibi).
/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate

# Olmayan dosya SPA fallback ile HTML döner; bunlar gerçek dosya (tarayıcı /favicon.ico'yu
# bağlantısız da ister; robots.txt tarayıcılar için). favicon.ico PNG baytlı - tarayıcılar kabul eder.
/robots.txt
  Cache-Control: public, max-age=3600
/favicon.ico
  Cache-Control: public, max-age=86400
